# Database Configuration
DATABASE_URL="mysql://username:password@localhost:3306/next_shadcn_dashboard?connection_limit=10"

# Hosts PostgreSQL (machine_info in adsng)
# Option 1: Connection string
# HOSTS_DB_URL="postgresql://ads_infras:Ads_0nline_Infras@10.61.230.2:5432/adsng?sslmode=disable"
# Option 2: Individual vars (defaults match your config)
# HOSTS_DB_HOST=10.61.230.2
# HOSTS_DB_PORT=5432
# HOSTS_DB_USER=ads_infras
# HOSTS_DB_PASSWORD=Ads_0nline_Infras
# HOSTS_DB_NAME=adsng
# HOSTS_DB_SSLMODE=disable

# Environment Configuration
# Set to "dev" or "test" to use test CAS server, or leave unset for production
ENV=dev

# CAS Configuration (optional - defaults based on ENV)
# CAS redirect (match host: ops3 for dev/test, ops4 for prod)
CAS_REDIRECT_URL="http://ops3-19ee08662.qiyi.virtual:3000/dashboard/"

# App URL (required for CAS - use ops3 for dev/test, ops4 for production)
# ops3-19ee08662.qiyi.virtual = dev & test
# ops4-1553aa9d7.qiyi.virtual = production
NEXT_PUBLIC_APP_URL="http://ops3-19ee08662.qiyi.virtual:3000"

# Pangaea API Configuration
# Test node (default for development)
PANGAEA_API_BASE_URL="http://ops3-19ee08662.qiyi.virtual:8080"

# Production node (uncomment and use for production)
# PANGAEA_API_BASE_URL="http://ops.cupid.qiyi.domain/"
